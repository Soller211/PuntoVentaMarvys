{
  "name": "punto-venta-marvys",
  "productName": "Punto de Venta",
  "version": "1.2.0",
  "description": "Punto de venta para restaurante a domicilio",
  "author": "Marvys",
  "main": "electron-main.js",
  "scripts": {
    "start": "electron .",
    "make-icon": "node build-icon.js",
    "dist": "node build-icon.js && electron-builder --win --publish never"
  },
  "devDependencies": {
    "electron": "^31.7.7",
    "electron-builder": "^24.13.3",
    "sharp": "^0.33.5"
  },
  "build": {
    "appId": "com.marvys.puntoventa",
    "productName": "Punto de Venta",
    "directories": { "output": "dist" },
    "files": [
      "index.html",
      "app.js",
      "license-core.js",
      "styles.css",
      "icon.svg",
      "manifest.webmanifest",
      "sw.js",
      "electron-main.js",
      "build/icon.png"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Punto de Venta"
    }
  }
}
